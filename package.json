{
    "name":  "dsh-skill-manager",
    "version":  "0.1.12",
    "description":  "Local skill manager for DeepSeek Harness: list \u0026 search, enable/disable and uninstall installed skills, from the /skill command and the Settings - Skills page.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings-general"
                                          ]
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.2",
                             "@deepseek-ai/dsh-commands":  ">=0.1.5-rc.1 <1.0.0-0",
                             "@deepseek-ai/dsh-skill":  ">=0.1.5-rc.1 <1.0.0-0",
                             "@deepseek-ai/dsh-host-webserver":  ">=0.1.5-rc.1 <1.0.0-0"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-commands":  {
                                                                   "optional":  true
                                                               },
                                 "@deepseek-ai/dsh-skill":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/dsh-host-webserver":  {
                                                                         "optional":  true
                                                                     }
                             },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "scripts":  {
                    "test":  "node tests/smoke.mjs && node tests/client-bundle.mjs && node tests/command-plane.mjs && node tests/http-routes.mjs && node tests/concurrency.mjs",
                    "test:core":  "node tests/smoke.mjs",
                    "test:client":  "node tests/client-bundle.mjs",
                    "test:command":  "node tests/command-plane.mjs",
                    "test:http":  "node tests/http-routes.mjs",
                    "test:lock":  "node tests/concurrency.mjs",
                    "preflight":  "node tools/preflight.mjs",
                    "live-check":  "node tools/live-check.mjs"
                },
    "license":  "MIT"
}