{
    "name":  "dsh-skill-manager",
    "version":  "0.1.5",
    "description":  "Local skill manager for DeepSeek Harness: list \u0026 search, enable/disable and uninstall installed skills, from the /skill command and the Settings - Skills page.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.2",
                             "@deepseek-ai/dsh-commands":  "^0.1.5-rc.1",
                             "@deepseek-ai/dsh-skill":  "^0.1.5-rc.1",
                             "@deepseek-ai/dsh-host-webserver":  "^0.1.5-rc.1"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-commands":  {
                                                                   "optional":  true
                                                               },
                                 "@deepseek-ai/dsh-skill":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/dsh-host-webserver":  {
                                                                         "optional":  true
                                                                     }
                             },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "license":  "MIT"
}